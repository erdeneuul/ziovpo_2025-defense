    {
      "name": "4-5 - Signatures and binary API",
      "item": [
        {
          "name": "01 Create signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/signatures",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"threatName\": \"Demo.Trojan\",\n  \"firstBytesHex\": \"4d5a900003000000\",\n  \"remainderHashHex\": \"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\n  \"remainderLength\": 1024,\n  \"fileType\": \"exe\",\n  \"offsetStart\": 0,\n  \"offsetEnd\": 1031\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signature created and signed', () => { pm.response.to.have.status(201); const j=pm.response.json(); pm.expect(j.digitalSignatureBase64).to.be.a('string').and.not.empty; });",
                  "const j=pm.response.json(); pm.collectionVariables.set('signatureId',j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Update signature",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/signatures/{{signatureId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"threatName\": \"Demo.Trojan.Updated\",\n  \"firstBytesHex\": \"4d5a900003000000\",\n  \"remainderHashHex\": \"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\n  \"remainderLength\": 2048,\n  \"fileType\": \"exe\",\n  \"offsetStart\": 0,\n  \"offsetEnd\": 2055\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signature updated and signed', () => { pm.response.to.have.status(200); const j=pm.response.json(); pm.expect(j.threatName).to.eql('Demo.Trojan.Updated'); pm.expect(j.digitalSignatureBase64).not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/signatures/{{signatureId}}/history"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('History contains previous version', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Audit",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/signatures/{{signatureId}}/audit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Audit contains operations', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Get by IDs",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/signatures/by-ids",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\n    \"{{signatureId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Selection by IDs works', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.eql(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Full JSON export",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/signatures"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ACTUAL signature appears in full export', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().some(x=>x.id===pm.collectionVariables.get('signatureId'))).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Binary full: multipart + magic numbers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/binary/signatures/full"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('multipart/mixed response', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('multipart/mixed'); });",
                  "pm.test('Both magic numbers are visible', () => { const text=pm.response.text(); pm.expect(text).to.include('MF-Erdeneuul'); pm.expect(text).to.include('DB-Erdeneuul'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Delete signature (logical)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/signatures/{{signatureId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logical delete succeeded', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Full JSON no longer contains deleted",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/signatures"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deleted record absent from full export', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().some(x=>x.id===pm.collectionVariables.get('signatureId'))).to.be.false; });"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Increment includes DELETED",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/signatures/increment?since=2000-01-01T00:00:00Z"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deleted record is in increment', () => { pm.response.to.have.status(200); const x=pm.response.json().find(x=>x.id===pm.collectionVariables.get('signatureId')); pm.expect(x).to.be.an('object'); pm.expect(x.status).to.eql('DELETED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Binary increment",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/binary/signatures/increment?since=2000-01-01T00:00:00Z"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Binary increment is multipart', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('multipart/mixed'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6 - MinIO",
      "item": [
        {
          "name": "01 Upload sample file",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "demo/sample.txt"
                }
              ]
            },
            "url": "{{baseUrl}}/api/admin/signatures/files/upload"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('File uploaded and signature created', () => pm.response.to.have.status(200));",
                  "const j=pm.response.json(); pm.collectionVariables.set('fileSignatureId',j.signature.id); pm.collectionVariables.set('objectName',j.objectName);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Get pre-signed URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/admin/signatures/files/presigned-urls",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\n    \"{{fileSignatureId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pre-signed URL returned', () => { pm.response.to.have.status(200); const j=pm.response.json(); const url=j[pm.collectionVariables.get('fileSignatureId')]; pm.expect(url).to.be.a('string').and.not.empty; pm.collectionVariables.set('presignedUrl',url); });"
                ]
              }
            }
          ]
        },
