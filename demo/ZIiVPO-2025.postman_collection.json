{
  "info": {
    "_postman_id": "4c9f83f2-8cce-4f19-b125-202511030001",
    "name": "ZIiVPO 2025 - Defense Demo",
    "description": "Run requests from top to bottom. Tests save JWT tokens and created IDs automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - JWT and roles",
      "item": [
        {
          "name": "01 Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"AdminDemo1!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('adminAccessToken', j.accessToken);",
                  "pm.collectionVariables.set('adminRefreshToken', j.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Who am I (ROLE_ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ADMIN role is visible', () => { pm.response.to.have.status(200); pm.expect(pm.response.text()).to.include('ROLE_ADMIN'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Refresh token pair",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh succeeded', () => pm.response.to.have.status(200));",
                  "const oldToken = pm.collectionVariables.get('adminRefreshToken');",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('usedRefreshToken', oldToken);",
                  "pm.collectionVariables.set('adminAccessToken', j.accessToken);",
                  "pm.collectionVariables.set('adminRefreshToken', j.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Replay old refresh -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{usedRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Old refresh is rejected', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Register USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student\",\n  \"password\": \"Student1!\",\n  \"role\": \"ROLE_ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('USER created or already exists', () => pm.expect([200,400]).to.include(pm.response.code));",
                  "pm.test('Public registration cannot grant ADMIN', () => { if (pm.response.code === 200) pm.expect(pm.response.text()).to.include('ROLE_USER'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Login USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student\",\n  \"password\": \"Student1!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('USER login succeeded', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json(); pm.collectionVariables.set('userAccessToken', j.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "07 USER blocked from admin URL -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/admin/signatures/files/presigned-urls"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('USER has no ADMIN access', () => pm.expect([403,405]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
