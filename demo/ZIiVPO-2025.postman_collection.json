                ]
              }
            }
          ]
        },
        {
          "name": "04 Activate license as USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/license/activate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{licenseCode}}\",\n  \"deviceId\": \"{{deviceId}}\",\n  \"deviceName\": \"Commission laptop\",\n  \"macAddress\": \"00-11-22-33-44-55\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ticket and EDS returned', () => { pm.response.to.have.status(200); const j=pm.response.json(); pm.expect(j.ticket).to.be.an('object'); pm.expect(j.digitalSignature).to.be.a('string').and.not.empty; });",
                  "pm.test('All Ticket fields exist', () => { const t=pm.response.json().ticket; ['serverDate','ticketLifetime','activationDate','expirationDate','userId','deviceId','isBlocked'].forEach(k=>pm.expect(t).to.have.property(k)); });"
                ]
              }
            }
          ]
        },
